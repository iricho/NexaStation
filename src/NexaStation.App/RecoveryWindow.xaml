<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NexaStation.App.RecoveryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NexaStation.App.Controls">
  <Grid Background="{StaticResource NexaBackgroundBrush}" Padding="64">
    <Border MaxWidth="980" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource NexaPanelBrush}" BorderBrush="{StaticResource NexaWarningBrush}" BorderThickness="1" CornerRadius="18" Padding="42">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Spacing="12">
          <TextBlock Text="RECOVERY" Foreground="{StaticResource NexaWarningBrush}" FontWeight="SemiBold" CharacterSpacing="140" />
          <TextBlock Text="NexaStation needs your attention" FontSize="38" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="ProblemText" FontSize="18" LineHeight="27" Foreground="{StaticResource NexaMutedTextBrush}" TextWrapping="Wrap" />
          <TextBlock x:Name="StatusText" Foreground="{StaticResource NexaAccentBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,30,0,30" ColumnSpacing="14" RowSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Button Content="Retry startup" Click="RetryClicked" MinHeight="54" Style="{StaticResource AccentButtonStyle}" />
          <Button Grid.Column="1" Content="Start in safe mode" Click="SafeModeClicked" MinHeight="54" />
          <Button Grid.Column="2" Content="Create backup" Click="BackupClicked" MinHeight="54" />
          <Button Grid.Row="1" Content="Restore a backup" Click="RestoreClicked" MinHeight="54" />
          <Button Grid.Row="1" Grid.Column="1" Content="Export diagnostics" Click="ExportClicked" MinHeight="54" />
          <Button x:Name="ResetButton" Grid.Row="1" Grid.Column="2" Content="Reset local library" Click="ResetClicked" MinHeight="54" />
        </Grid>

        <StackPanel Grid.Row="2" Spacing="12">
        <Grid>
          <TextBlock Text="Backups and diagnostics remain local until you choose to share them." Foreground="{StaticResource NexaMutedTextBrush}" />
          <Button Content="Exit NexaStation" Click="ExitClicked" HorizontalAlignment="Right" />
        </Grid>
        <controls:NexaInputHintBar x:Name="InputHints" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>

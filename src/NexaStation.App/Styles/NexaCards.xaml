<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <LinearGradientBrush x:Key="NexaCardGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#263E5C" Offset="0" /><GradientStop Color="#17283D" Offset="0.55" /><GradientStop Color="#16443F" Offset="1" /></LinearGradientBrush>
  <LinearGradientBrush x:Key="NexaCardScrimBrush" StartPoint="0.5,0" EndPoint="0.5,1"><GradientStop Color="#000B1220" Offset="0.28" /><GradientStop Color="#6808101B" Offset="0.64" /><GradientStop Color="#FA08101B" Offset="1" /></LinearGradientBrush>
  <Style x:Key="CardListStyle" TargetType="ListViewItem" BasedOn="{StaticResource NexaFocusableControlStyle}">
    <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,18,18" /><Setter Property="CornerRadius" Value="16" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style x:Key="CardGridStyle" TargetType="GridViewItem" BasedOn="{StaticResource NexaFocusableControlStyle}">
    <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,18,18" /><Setter Property="CornerRadius" Value="16" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style x:Key="HomeCardListStyle" TargetType="ListViewItem" BasedOn="{StaticResource NexaFocusableControlStyle}">
    <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="CornerRadius" Value="12" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style x:Key="NexaCardBorderStyle" TargetType="Border"><Setter Property="CornerRadius" Value="{StaticResource NexaRadiusLarge}" /><Setter Property="BorderBrush" Value="{StaticResource NexaCardBorderBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
</ResourceDictionary>

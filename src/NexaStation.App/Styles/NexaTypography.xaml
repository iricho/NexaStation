<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="NexaDisplayTitleStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Display" /><Setter Property="FontSize" Value="46" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
  <Style x:Key="NexaHeroTitleStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Display" /><Setter Property="FontSize" Value="40" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
  <Style x:Key="NexaPageTitleStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Display" /><Setter Property="FontSize" Value="36" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style x:Key="NexaSectionHeadingStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Display" /><Setter Property="FontSize" Value="19" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style x:Key="NexaCardTitleStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Display" /><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
  <Style x:Key="NexaCardSubtitleStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Display" /><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="{StaticResource NexaMutedTextBrush}" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
  <Style x:Key="NexaNavigationLabelStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Display" /><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style x:Key="NexaCaptionStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Display" /><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{StaticResource NexaMutedTextBrush}" /></Style>
</ResourceDictionary>

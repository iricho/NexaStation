<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="SectionToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource NexaFocusableControlStyle}">
    <Setter Property="Background" Value="#00171C28" /><Setter Property="BorderThickness" Value="0,0,0,3" /><Setter Property="BorderBrush" Value="{StaticResource NexaAccentBrush}" /><Setter Property="CornerRadius" Value="24" /><Setter Property="Padding" Value="16,10" /><Setter Property="MinWidth" Value="88" /><Setter Property="MinHeight" Value="48" /><Setter Property="FontSize" Value="15" />
  </Style>
  <Style x:Key="ChromeIconButtonStyle" TargetType="Button" BasedOn="{StaticResource NexaFocusableControlStyle}">
    <Setter Property="Width" Value="44" /><Setter Property="Height" Value="44" /><Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="22" /><Setter Property="Background" Value="#1FFFFFFF" /><Setter Property="BorderBrush" Value="{StaticResource NexaCardBorderBrush}" /><Setter Property="BorderThickness" Value="1" />
  </Style>
</ResourceDictionary>

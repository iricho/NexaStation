<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NexaStation.App.NexaMediaPlayerPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:NexaStation.App.Controls" IsTabStop="True" AutomationProperties.Name="NexaStation video player">
  <Grid x:Name="PlayerRoot" Background="Black" KeyDown="PlayerRoot_KeyDown" PointerMoved="PlayerRoot_PointerMoved">
    <MediaPlayerElement x:Name="VideoSurface" AreTransportControlsEnabled="False" Stretch="Uniform" />
    <Border x:Name="TopOverlay" VerticalAlignment="Top" Padding="28,24" Background="#B0000000"><StackPanel><TextBlock x:Name="TitleText" FontSize="25" FontWeight="SemiBold" /><TextBlock x:Name="DetailText" Opacity="0.72" /></StackPanel></Border>
    <Border x:Name="ErrorOverlay" Background="#D0000000" Visibility="Collapsed" Padding="40"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"><TextBlock Text="This video could not be played in NexaStation." FontSize="23" TextAlignment="Center" /><TextBlock x:Name="ErrorText" TextWrapping="Wrap" MaxWidth="620" TextAlignment="Center" /><StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"><Button Content="Open With" Click="OpenWith_Click" /><Button Content="Retry" Click="Retry_Click" /><Button Content="Back" Click="Back_Click" /></StackPanel></StackPanel></Border>
    <Border x:Name="TransportOverlay" VerticalAlignment="Bottom" Padding="24,18,24,22" Background="#D0000000">
      <StackPanel Spacing="10">
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="PositionText" VerticalAlignment="Center" /><Slider x:Name="Timeline" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="Timeline_ValueChanged" AutomationProperties.Name="Playback position" /><TextBlock x:Name="DurationText" Grid.Column="2" VerticalAlignment="Center" /></Grid>
        <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center"><Button Content="Previous" Click="Previous_Click" /><Button Content="−10s" Click="SkipBack_Click" /><Button x:Name="PlayPauseButton" Content="Play" Click="PlayPause_Click" /><Button Content="Stop" Click="Stop_Click" /><Button Content="+30s" Click="SkipForward_Click" /><Button Content="Next" Click="Next_Click" /><Button x:Name="MuteButton" Content="Mute" Click="Mute_Click" /><Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="1" StepFrequency="0.05" ValueChanged="Volume_ValueChanged" AutomationProperties.Name="Player volume" /><Button Content="Subtitles" Click="Subtitles_Click" /><Button Content="Audio" Click="Audio_Click" /><Button Content="More Options" Click="More_Click" /><Button Content="Fullscreen" Click="Fullscreen_Click" /><Button Content="Back" Click="Back_Click" /></StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center"><controls:NexaInputHint x:Name="ConfirmHint" /><controls:NexaInputHint x:Name="CancelHint" /><controls:NexaInputHint x:Name="ContextHint" /><controls:NexaInputHint x:Name="OptionsHint" /><controls:NexaInputHint x:Name="DetailsHint" /></StackPanel>
        </StackPanel>
    </Border>
  </Grid>
</UserControl>

        <StackPanel>
        <ItemsControl ItemsSource="{x:Bind MediaViewModel.Rows, Mode=OneWay}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MediaHubDisplayRowViewModel"><StackPanel Spacing="10" Margin="0,0,0,18"><TextBlock Text="{x:Bind Title}" FontSize="21" FontWeight="SemiBold" />
          <ListView ItemsSource="{x:Bind LibraryItems}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Card_ItemClick" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollMode="Disabled"><ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListView.ItemsPanel><ListView.ItemTemplate><DataTemplate x:DataType="vm:CardViewModel"><controls:NexaApplicationTile Card="{x:Bind}" /></DataTemplate></ListView.ItemTemplate></ListView>
          <ListView ItemsSource="{x:Bind GalleryItems}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="GalleryCard_ItemClick" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollMode="Disabled"><ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListView.ItemsPanel><ListView.ItemTemplate><DataTemplate x:DataType="vm:GalleryCardViewModel"><controls:NexaVideoCard Card="{x:Bind}" /></DataTemplate></ListView.ItemTemplate></ListView>
        </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,20"><Button Content="Add Local Video Folder" Click="AddVideoFolder_Click" /><Button Content="Discover Media Apps" Click="ShowDiscoverApps_Click" /></StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Grid x:Name="GalleryRoot" Grid.Row="2" Margin="60,16,60,60" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <StackPanel Spacing="12">
        <TextBlock Text="Gallery" FontSize="42" FontWeight="SemiBold" />
        <TextBlock Text="Private, local-first photos, screenshots, recordings, and videos from folders you approve." Foreground="{StaticResource NexaMutedTextBrush}" FontSize="16" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <AutoSuggestBox x:Name="GallerySearch" Width="340" PlaceholderText="Search filename or folder" TextChanged="GallerySearch_TextChanged" QueryIcon="Find" />
          <ComboBox Width="150" Header="View" SelectedIndex="0" SelectionChanged="GalleryView_SelectionChanged"><x:String>Home</x:String><x:String>Timeline</x:String><x:String>Folders</x:String><x:String>Grid</x:String><x:String>Albums</x:String></ComboBox>
          <ComboBox Width="150" Header="Grid size" SelectedIndex="1" SelectionChanged="GalleryGrid_SelectionChanged"><x:String>Small</x:String><x:String>Medium</x:String><x:String>Large</x:String></ComboBox>
          <ComboBox Width="190" Header="Sort" SelectedIndex="0" SelectionChanged="GallerySort_SelectionChanged"><x:String>Newest captured</x:String><x:String>Oldest captured</x:String><x:String>Recently added</x:String><x:String>Recently opened</x:String><x:String>Filename</x:String><x:String>File size</x:String></ComboBox>
          <Button Content="Add Gallery Folder" Click="AddGalleryFolder_Click" />
          <Button Content="Create Album" Click="CreateAlbum_Click" />
        </StackPanel>
      </StackPanel>
      <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Hidden">
        <StackPanel Spacing="18">
          <controls:NexaEmptyState Glyph="&#xEB9F;" Title="{x:Bind GalleryViewModel.EmptyTitle, Mode=OneWay}" Message="{x:Bind GalleryViewModel.EmptyMessage, Mode=OneWay}" Visibility="{x:Bind GalleryViewModel.EmptyVisibility, Mode=OneWay}" />
          <ItemsControl ItemsSource="{x:Bind GalleryViewModel.Rows, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GalleryRowViewModel">
                <StackPanel Spacing="10" Margin="0,0,0,18">
                  <TextBlock Text="{x:Bind Title}" FontSize="21" FontWeight="SemiBold" />
                  <ListView ItemsSource="{x:Bind Items}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="GalleryCard_ItemClick" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListView.ItemsPanel>
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource CardListStyle}" /></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                      <DataTemplate x:DataType="vm:GalleryCardViewModel">
                        <Border Width="{x:Bind Width}" Height="{x:Bind Height}" CornerRadius="16" Background="{StaticResource NexaCardGradient}" BorderBrush="{StaticResource NexaAccentBorderBrush}" BorderThickness="1" Loaded="GalleryCard_Loaded">
                          <Grid>
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                            <Border VerticalAlignment="Bottom" Background="{StaticResource NexaArtworkCaptionBrush}" Padding="12,8">
                              <Grid><StackPanel><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{x:Bind Subtitle}" FontSize="11" Foreground="{StaticResource NexaMutedTextBrush}" TextTrimming="CharacterEllipsis" /></StackPanel><TextBlock Text="{x:Bind Duration}" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="11" /></Grid>
                            </Border>
                            <FontIcon Glyph="&#xE734;" Foreground="{StaticResource NexaAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <controls:NexaControllerFooter x:Name="ControllerFooter" Grid.Row="3" />

    <Grid x:Name="GalleryViewerOverlay" Grid.RowSpan="4" Background="{StaticResource NexaViewerOverlayBrush}" Visibility="Collapsed" KeyDown="GalleryViewer_KeyDown">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Margin="30,22"><Button Content="← Gallery" Click="GalleryViewerBack_Click" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="Details" Click="GalleryViewerDetails_Click" /><Button Content="Favorite" Click="GalleryViewerFavorite_Click" /><Button Content="Set Background" Click="GalleryViewerBackground_Click" /><Button Content="Open External" Click="GalleryViewerExternal_Click" /><Button Content="Open Location" Click="GalleryViewerLocation_Click" /></StackPanel></Grid>
      <Grid Grid.Row="1" x:Name="ViewerSurface">
        <Image x:Name="GalleryViewerImage" Stretch="Uniform" ManipulationMode="TranslateX,TranslateY" ManipulationDelta="GalleryViewerImage_ManipulationDelta" PointerWheelChanged="GalleryViewerImage_PointerWheelChanged">
          <Image.RenderTransform><CompositeTransform x:Name="GalleryViewerTransform" /></Image.RenderTransform>
        </Image>
        <ProgressRing x:Name="GalleryViewerLoading" Width="54" Height="54" IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Button Content="‹" FontSize="42" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="28" Click="GalleryViewerPrevious_Click" />
        <Button Content="›" FontSize="42" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="28" Click="GalleryViewerNext_Click" />
      </Grid>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="20"><Button Content="Zoom −" Click="GalleryViewerZoomOut_Click" /><Button Content="Zoom +" Click="GalleryViewerZoomIn_Click" /><Button Content="Fit" Click="GalleryViewerFit_Click" /><Button Content="Actual Size" Click="GalleryViewerActual_Click" /><Button Content="Slideshow" Click="GalleryViewerSlideshow_Click" /><TextBlock x:Name="GalleryViewerCaption" VerticalAlignment="Center" Margin="18,0" /></StackPanel>
    </Grid>

    <Grid x:Name="QuickMenuOverlay" Grid.RowSpan="4" Background="{StaticResource NexaQuickDimBrush}" Visibility="Collapsed" IsTabStop="True">
      <Border Width="430" HorizontalAlignment="Right" Margin="0,18,18,18" Padding="28" CornerRadius="24" Background="{StaticResource NexaQuickPanelBrush}" BorderBrush="{StaticResource NexaAccentBorderBrush}" BorderThickness="1">
        <ScrollViewer><StackPanel Spacing="14">
          <Grid><TextBlock Text="Quick Menu" FontSize="30" FontWeight="SemiBold" /><Button Content="Close" HorizontalAlignment="Right" Click="QuickMenuClose_Click" /></Grid>
          <TextBlock x:Name="QuickTimeText" FontSize="18" Foreground="{StaticResource NexaMutedTextBrush}" />
          <Border Padding="14" CornerRadius="12" Background="{StaticResource NexaTranslucentSurfaceBrush}"><StackPanel><TextBlock Text="CURRENT ACTIVITY" FontSize="11" CharacterSpacing="100" /><TextBlock x:Name="QuickActivityText" FontSize="18" /></StackPanel></Border>
          <TextBlock Text="Audio" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="QuickAudioDeviceText" Text="Audio status unavailable" /><Slider x:Name="QuickVolumeSlider" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="QuickVolumeSlider_ValueChanged" />
          <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Mute" Tag="audio.mute" Click="QuickAction_Click" /><Button Content="Sound Settings" Tag="audio.settings" Click="QuickAction_Click" /></StackPanel>
          <TextBlock Text="Media controls" FontSize="20" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Previous" Tag="media.previous" Click="QuickAction_Click" /><Button Content="Play / Pause" Tag="media.playpause" Click="QuickAction_Click" /><Button Content="Next" Tag="media.next" Click="QuickAction_Click" /></StackPanel>
          <TextBlock Text="Capture" FontSize="20" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Capture Screenshot" Tag="capture.screenshot" Click="QuickAction_Click" /><Button Content="Snipping Tool" Tag="capture.snipping" Click="QuickAction_Click" /></StackPanel>
          <TextBlock Text="Status" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="QuickControllerText" Text="Controller status unknown" /><TextBlock x:Name="QuickNetworkText" Text="Network status unknown" />
          <Button x:Name="QuickGuestButton" Content="Guest Mode" Click="GuestSettings_Click" HorizontalAlignment="Stretch" />
          <TextBlock Text="Window" FontSize="20" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Minimize" Tag="window.minimize" Click="QuickAction_Click" /><Button Content="Desktop" Tag="window.desktop" Click="QuickAction_Click" /><Button Content="Restart NexaStation" Tag="window.restart" Click="QuickAction_Click" /></StackPanel>
          <TextBlock Text="Power" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Power actions require confirmation. Restart and Shut Down require a 1.5 second hold." TextWrapping="Wrap" Foreground="{StaticResource NexaMutedTextBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Sleep" Tag="power.sleep" Click="QuickAction_Click" /><Button Content="Sign Out" Tag="power.signout" Click="QuickAction_Click" /><Button Content="Restart PC" Tag="power.restart" PointerPressed="QuickHold_PointerPressed" PointerReleased="QuickHold_PointerReleased" PointerCanceled="QuickHold_PointerReleased" KeyDown="QuickHold_KeyDown" KeyUp="QuickHold_KeyUp" /><Button Content="Shut Down" Tag="power.shutdown" PointerPressed="QuickHold_PointerPressed" PointerReleased="QuickHold_PointerReleased" PointerCanceled="QuickHold_PointerReleased" KeyDown="QuickHold_KeyDown" KeyUp="QuickHold_KeyUp" /></StackPanel>
          <ProgressBar x:Name="QuickHoldProgress" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" AutomationProperties.Name="Destructive action hold progress" />
          <InfoBar x:Name="QuickConfirmationBar" IsOpen="False" Severity="Warning" Title="Confirmation required" IsClosable="True" CloseButtonClick="QuickConfirmation_Close" />
          <TextBlock Text="Notifications" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="QuickNotificationsText" Text="No NexaStation notifications" TextWrapping="Wrap" />
          <TextBlock Text="Use the mapped Quick Menu action to close this panel and restore the exact originating control." Foreground="{StaticResource NexaMutedTextBrush}" TextWrapping="Wrap" />
        </StackPanel></ScrollViewer>
      </Border>
    </Grid>

    <Grid
        Grid.RowSpan="4"
        Background="{StaticResource NexaToastBrush}"
        Visibility="{x:Bind ViewModel.IsLaunching, Mode=OneWay}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
        <ProgressRing IsActive="{x:Bind ViewModel.IsLaunching, Mode=OneWay}" Width="54" Height="54" />
        <TextBlock Text="Launching…" FontSize="21" />
      </StackPanel>
    </Grid>
  </Grid>
  <Grid x:Name="NativePlayerOverlay" Background="Black" Visibility="Collapsed" Canvas.ZIndex="1000">
    <local:NexaMediaPlayerPage x:Name="NativePlayerPage" />
  </Grid>
  <Grid x:Name="SettingsOverlay" Background="{StaticResource NexaBackgroundBrush}" Visibility="Collapsed" Canvas.ZIndex="1100">
    <ContentControl x:Name="SettingsViewHost" IsTabStop="True" AutomationProperties.Name="Settings" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
  </Grid>
  </Grid>
</Window>

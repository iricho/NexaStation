<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NexaStation.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:NexaStation.App.ViewModels"
    xmlns:controls="using:NexaStation.App.Controls"
    xmlns:local="using:NexaStation.App"
    xmlns:custom="using:NexaStation.Customization.Models"
    mc:Ignorable="d"
    Title="NexaStation">

  <Grid x:Name="WindowRoot" Background="{StaticResource NexaBackgroundBrush}" SizeChanged="WindowRoot_SizeChanged">
  <Grid
      x:Name="Root"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      IsTabStop="True"
      Loaded="Root_Loaded"
      SizeChanged="Root_SizeChanged"
      GettingFocus="Root_GettingFocus"
      KeyDown="Root_KeyDown"
      RightTapped="Root_RightTapped"
      Holding="Root_Holding"
      PointerMoved="Root_PointerMoved"
      PointerPressed="Root_PointerPressed">
    <Grid.Resources>
      <DataTemplate x:Key="NexaGameCardTemplate" x:DataType="vm:CardViewModel"><controls:NexaGameCard Card="{x:Bind}" /></DataTemplate>
      <DataTemplate x:Key="NexaApplicationCardTemplate" x:DataType="vm:CardViewModel"><controls:NexaApplicationTile Card="{x:Bind}" /></DataTemplate>
      <DataTemplate x:Key="NexaGalleryCardTemplate" x:DataType="vm:GalleryCardViewModel"><controls:NexaGalleryCard Card="{x:Bind}" /></DataTemplate>
      <DataTemplate x:Key="NexaHomeGameCardTemplate" x:DataType="vm:CardViewModel"><controls:NexaHomeGameCard Card="{x:Bind}" /></DataTemplate>
      <DataTemplate x:Key="NexaHomeApplicationTileTemplate" x:DataType="vm:CardViewModel"><controls:NexaHomeApplicationTile Card="{x:Bind}" /></DataTemplate>
      <DataTemplate x:Key="NexaHomeFavoriteTileTemplate" x:DataType="vm:CardViewModel"><controls:NexaHomeFavoriteTile Card="{x:Bind}" /></DataTemplate>
      <DataTemplate x:Key="NexaHomeGalleryTileTemplate" x:DataType="vm:GalleryCardViewModel"><controls:NexaHomeGalleryTile Card="{x:Bind}" /></DataTemplate>
      <DataTemplate x:Key="NexaHomeActivityRowTemplate" x:DataType="vm:CardViewModel"><controls:NexaHomeActivityRow Card="{x:Bind}" /></DataTemplate>
      <DataTemplate x:Key="NexaHomeServiceTileTemplate" x:DataType="vm:DiscoverAppCardViewModel"><controls:NexaHomeServiceTile Card="{x:Bind}" /></DataTemplate>
      <controls:ContentCardTemplateSelector x:Key="NexaContentCardSelector" GameTemplate="{StaticResource NexaGameCardTemplate}" ApplicationTemplate="{StaticResource NexaApplicationCardTemplate}" MediaTemplate="{StaticResource NexaApplicationCardTemplate}" />
    </Grid.Resources>
    <Grid.Background><SolidColorBrush Color="{StaticResource NexaBackgroundColor}" /></Grid.Background>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Image x:Name="DashboardBackgroundImage" Grid.RowSpan="4" Source="{x:Bind ViewModel.DashboardBackgroundArtwork, Mode=OneWay}" Stretch="UniformToFill" Opacity="0.2" IsHitTestVisible="False" />
    <Border Grid.RowSpan="4" Background="{StaticResource NexaWindowScrimBrush}" IsHitTestVisible="False" />

    <Grid x:Name="TopHeader" Grid.Row="0" Padding="48,17,48,12" Background="{StaticResource NexaChromeBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="238" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel x:Name="HeaderBrand" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource NexaAccentBrush}">
          <FontIcon Glyph="&#xE950;" Foreground="{StaticResource NexaInverseAccentTextBrush}" FontSize="21" />
        </Border>
        <StackPanel>
          <TextBlock Text="NexaStation" FontSize="20" FontWeight="SemiBold" />
          <TextBlock x:Name="BrandSubtitle" Text="GAMES · APPS · MEDIA" FontSize="9" Foreground="{StaticResource NexaMutedTextBrush}" CharacterSpacing="115" />
        </StackPanel>
      </StackPanel>

      <ItemsControl x:Name="HeaderSections" Grid.Column="1" ItemsSource="{x:Bind ViewModel.Sections, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DashboardSectionViewModel">
            <ToggleButton
                Style="{StaticResource SectionToggleStyle}"
                IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                Visibility="{x:Bind Visibility, Mode=OneWay}"
                Click="Section_Click">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" />
              </StackPanel>
            </ToggleButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
        <FontIcon Glyph="&#xE701;" FontSize="17" Foreground="{StaticResource NexaSoftWhiteBrush}" ToolTipService.ToolTip="Network" />
        <Border Width="38" Height="38" CornerRadius="19" Background="#16FFFFFF">
          <FontIcon Glyph="&#xE7FC;" FontSize="17" ToolTipService.ToolTip="Controller status" />
        </Border>
        <TextBlock x:Name="HeaderControllerStatus" Text="LOCAL" FontSize="10" Foreground="{StaticResource NexaMutedTextBrush}" VerticalAlignment="Center" />
        <TextBlock x:Name="HeaderBatteryStatus" Text="" FontSize="10" Foreground="{StaticResource NexaMutedTextBrush}" VerticalAlignment="Center" />
        <Button x:Name="GuestProfileButton" Style="{StaticResource ChromeIconButtonStyle}" Width="48" Height="48" ToolTipService.ToolTip="Owner and Guest Mode" Click="GuestSettings_Click">
          <Grid Width="38" Height="38">
            <Border x:Name="OwnerAvatarBorder" CornerRadius="19" Background="{StaticResource NexaAccentBrush}" Opacity="0.32" />
            <TextBlock x:Name="UserInitialsText" Text="USR" FontSize="11" FontWeight="SemiBold" CharacterSpacing="65" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource NexaAccentBrush}" BorderBrush="{StaticResource NexaBackgroundBrush}" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
          </Grid>
        </Button>
        <Button x:Name="TouchQuickMenuButton" Style="{StaticResource ChromeIconButtonStyle}" ToolTipService.ToolTip="Open Quick Menu" AutomationProperties.Name="Open Quick Menu" Click="TouchQuickMenu_Click"><FontIcon Glyph="&#xE700;" FontSize="18" /></Button>
        <Rectangle Width="1" Height="28" Fill="{StaticResource NexaCardBorderBrush}" Margin="2,0" />
        <TextBlock x:Name="HeaderClock" Text="--:--" FontSize="15" VerticalAlignment="Center" />
        <Button x:Name="ManageButton" Style="{StaticResource ChromeIconButtonStyle}" ToolTipService.ToolTip="Manage NexaStation">
          <Button.Content><FontIcon Glyph="&#xE713;" FontSize="18" /></Button.Content>
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuFlyoutItem Text="Settings" Click="SettingsHome_Click" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem Text="Add Library Item" Click="AddItem_Click" />
              <MenuFlyoutItem Text="Import Steam" Click="ImportSteam_Click" />
              <MenuFlyoutItem Text="Refresh Steam" Click="RefreshSteam_Click" />
              <MenuFlyoutItem Text="Scan Other Game Launchers" Click="ScanLaunchers_Click" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem Text="Import Emulated Games" Click="ImportEmulatedGames_Click" />
              <MenuFlyoutItem Text="Scan Windows Apps" Click="ImportWindowsApps_Click" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem Text="Add Gallery Folder" Click="AddGalleryFolder_Click" />
              <MenuFlyoutItem Text="Refresh Gallery" Click="RefreshGallery_Click" />
              <MenuFlyoutItem Text="Find Missing Artwork" Click="FindMissingArtwork_Click" />
              <MenuFlyoutItem Text="Review Artwork Matches" Click="ReviewArtworkMatches_Click" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem Text="Activity Timeline" Click="ActivityTimeline_Click" />
              <MenuFlyoutItem Text="Report a Problem" Click="ReportProblem_Click" />
              <MenuFlyoutItem Text="Retry Library" Click="RetryDatabase_Click" />
              <MenuFlyoutItem Text="Open Data Folder" Click="OpenDataFolder_Click" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem Text="Close NexaStation" Click="CloseApplication_Click" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Grid>

    <controls:NexaToastHost
        Grid.Row="1"
        Margin="0,8,48,0"
        HorizontalAlignment="Right"
        Visibility="{x:Bind ViewModel.NotificationVisibility, Mode=OneWay}"
        Severity="{x:Bind ViewModel.CurrentNotification.Severity, Mode=OneWay}"
        Title="{x:Bind ViewModel.CurrentNotification.Title, Mode=OneWay}"
        Message="{x:Bind ViewModel.CurrentNotification.Message, Mode=OneWay}"
        PrimaryText="{x:Bind ViewModel.CurrentNotification.PrimaryAction, Mode=OneWay}"
        SecondaryText="{x:Bind ViewModel.CurrentNotification.SecondaryAction, Mode=OneWay}"
        PrimaryClick="ToastPrimary_Click"
        SecondaryClick="ToastSecondary_Click"
        DismissClick="ToastDismiss_Click" />

    <Border x:Name="ArtworkJobStrip" Grid.Row="1" Margin="48,8,500,0" Padding="14,10" CornerRadius="10" Background="{StaticResource NexaChromeBrush}" BorderBrush="{StaticResource NexaCardBorderBrush}" BorderThickness="1" Visibility="Collapsed">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock x:Name="ArtworkJobTitle" Text="Artwork job" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="ArtworkJobStage" Text="Preparing" FontSize="11" Foreground="{StaticResource NexaMutedTextBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><ProgressBar x:Name="ArtworkJobProgress" Minimum="0" Maximum="1" Value="0" /><TextBlock x:Name="ArtworkJobCounts" FontSize="11" Foreground="{StaticResource NexaMutedTextBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Button x:Name="ArtworkPauseButton" Content="Pause" Click="ArtworkPause_Click" /><Button x:Name="ArtworkResumeButton" Content="Resume" Click="ArtworkResume_Click" Visibility="Collapsed" /><Button x:Name="ArtworkCancelButton" Content="Cancel" Click="ArtworkCancel_Click" /><Button Content="Details" Click="ArtworkDetails_Click" /></StackPanel>
      </Grid>
    </Border>

    <ScrollViewer
        x:Name="DashboardContent"
        Grid.Row="2"
        Margin="0,8,0,0"
        Background="#A6090B13"
        VerticalScrollBarVisibility="Hidden"
        HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="DashboardFrame" Margin="60,12,60,34" Spacing="24">
        <Grid x:Name="ModernHomeSurface" RowSpacing="13">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <controls:NexaHeroBanner
              x:Name="HeroBanner"
              Height="250"
              Artwork="{x:Bind ViewModel.FeaturedArtwork, Mode=OneWay}"
              Title="{x:Bind ViewModel.FeaturedTitle, Mode=OneWay}"
              Description="{x:Bind ViewModel.FeaturedDescription, Mode=OneWay}"
              PrimaryText="{x:Bind ViewModel.HeroPrimaryActionText, Mode=OneWay}"
              SecondaryText="{x:Bind ViewModel.HeroSecondaryActionText, Mode=OneWay}"
              IndicatorCount="{x:Bind ViewModel.HeroCount, Mode=OneWay}"
              SelectedIndex="{x:Bind ViewModel.SelectedHeroIndex, Mode=OneWay}"
              HeroIndexRequested="HeroBanner_HeroIndexRequested"
              PrimaryClick="HeroPlay_Click"
              SecondaryClick="HeroDetails_Click" />

          <StackPanel x:Name="ContinuePanel" Grid.Row="1" Spacing="7" Visibility="{x:Bind ViewModel.ContinueSectionVisibility, Mode=OneWay}">
            <TextBlock Text="{x:Bind ViewModel.ContinueSectionTitle, Mode=OneWay}" Style="{StaticResource NexaSectionHeadingStyle}" />
            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ListView ItemsSource="{x:Bind ViewModel.ContinueItems, Mode=OneWay}" ItemTemplate="{StaticResource NexaHomeGameCardTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Card_ItemClick" GotFocus="CardList_GotFocus" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollMode="Disabled"><ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListView.ItemsPanel><ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource HomeCardListStyle}" /></ListView.ItemContainerStyle></ListView><controls:NexaHomeEndpointTile x:Name="GamesEndpoint" Grid.Column="1" Width="96" Height="132" Glyph="&#xECA5;" Label="View All" Click="ViewAllGames_Click" /></Grid>
          </StackPanel>

          <Grid x:Name="DashboardPairGrid" Grid.Row="2" ColumnSpacing="22" RowSpacing="13">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" /><ColumnDefinition Width="1.33*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel x:Name="ApplicationsPanel" Spacing="7" Visibility="{x:Bind ViewModel.ApplicationSectionVisibility, Mode=OneWay}">
              <TextBlock Text="{x:Bind ViewModel.ApplicationSectionTitle, Mode=OneWay}" Style="{StaticResource NexaSectionHeadingStyle}" />
              <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ListView ItemsSource="{x:Bind ViewModel.RecentAppItems, Mode=OneWay}" ItemTemplate="{StaticResource NexaHomeApplicationTileTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Card_ItemClick" GotFocus="CardList_GotFocus" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollMode="Disabled"><ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListView.ItemsPanel><ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource HomeCardListStyle}" /></ListView.ItemContainerStyle></ListView><controls:NexaHomeEndpointTile x:Name="AppsEndpoint" Grid.Column="1" Width="96" Height="94" Glyph="&#xE71D;" Label="All Apps" Click="ViewAllApps_Click" /></Grid>
            </StackPanel>
            <StackPanel x:Name="RecentPhotosPanel" Grid.Column="1" Spacing="7" Visibility="{x:Bind GalleryViewModel.HomePreviewVisibility, Mode=OneWay}">
              <TextBlock Text="Recent Photos" Style="{StaticResource NexaSectionHeadingStyle}" />
              <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ListView ItemsSource="{x:Bind GalleryViewModel.HomePreview, Mode=OneWay}" ItemTemplate="{StaticResource NexaHomeGalleryTileTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="GalleryCard_ItemClick" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollMode="Disabled"><ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListView.ItemsPanel><ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource HomeCardListStyle}" /></ListView.ItemContainerStyle></ListView><controls:NexaHomeEndpointTile x:Name="PhotosEndpoint" Grid.Column="1" Width="76" Height="94" Glyph="&#xEB9F;" Label="View All" Click="ViewAllPhotos_Click" /></Grid>
            </StackPanel>
          </Grid>

          <Grid x:Name="DashboardLowerGrid" Grid.Row="3" ColumnSpacing="18" RowSpacing="13">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.78*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel x:Name="HomeMediaPanel" Spacing="7"><TextBlock Text="Media Services" Style="{StaticResource NexaSectionHeadingStyle}" /><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ListView ItemsSource="{x:Bind DiscoverAppsViewModel.StreamingItems, Mode=OneWay}" ItemTemplate="{StaticResource NexaHomeServiceTileTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="DiscoverCard_ItemClick" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollMode="Disabled"><ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListView.ItemsPanel><ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource HomeCardListStyle}" /></ListView.ItemContainerStyle></ListView><controls:NexaHomeEndpointTile x:Name="MediaEndpoint" Grid.Column="1" Width="70" Height="94" Glyph="&#xE712;" Label="More" Click="ViewAllMedia_Click" /></Grid></StackPanel>
            <StackPanel x:Name="FavoritesPanel" Grid.Column="1" Spacing="7" Visibility="{x:Bind ViewModel.FavoriteSectionVisibility, Mode=OneWay}"><TextBlock Text="Favorites" Style="{StaticResource NexaSectionHeadingStyle}" /><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ListView ItemsSource="{x:Bind ViewModel.FavoriteItems, Mode=OneWay}" ItemTemplate="{StaticResource NexaHomeFavoriteTileTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Card_ItemClick" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollMode="Disabled"><ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListView.ItemsPanel><ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource HomeCardListStyle}" /></ListView.ItemContainerStyle></ListView><controls:NexaHomeEndpointTile x:Name="FavoritesEndpoint" Grid.Column="1" Width="70" Height="94" Glyph="&#xE734;" Label="Manage" Click="ManageFavorites_Click" /></Grid></StackPanel>
            <StackPanel x:Name="RecentlyAddedPanel" Grid.Column="2" Spacing="7"><TextBlock Text="Recently Added" Style="{StaticResource NexaSectionHeadingStyle}" /><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ListView ItemsSource="{x:Bind ViewModel.RecentItems, Mode=OneWay}" ItemTemplate="{StaticResource NexaHomeActivityRowTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Card_ItemClick" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollMode="Disabled"><ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical" /></ItemsPanelTemplate></ListView.ItemsPanel><ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource HomeCardListStyle}" /></ListView.ItemContainerStyle></ListView><controls:NexaHomeEndpointTile x:Name="RecentEndpoint" Grid.Column="1" Width="70" Height="94" Glyph="&#xE896;" Label="View All" Click="ViewAllRecent_Click" /></Grid></StackPanel>
          </Grid>
        </Grid>

        <StackPanel x:Name="AppsCatalogueRoot" Spacing="20" Visibility="Collapsed">
          <StackPanel Spacing="5"><TextBlock Text="Apps" FontSize="42" FontWeight="SemiBold" /><TextBlock Text="Installed applications and a curated catalogue of safe Store and Web App destinations." FontSize="16" Foreground="{StaticResource NexaMutedTextBrush}" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8"><ToggleButton x:Name="InstalledAppsModeButton" Content="Installed Apps" IsChecked="True" Click="AppsMode_Click" Tag="Installed" MinWidth="142" /><ToggleButton x:Name="DiscoverAppsModeButton" Content="Discover Apps" Click="AppsMode_Click" Tag="Discover" MinWidth="142" /></StackPanel>
          <StackPanel x:Name="InstalledAppsPanel" Spacing="14"><TextBlock Text="Installed Apps" Style="{StaticResource NexaSectionHeadingStyle}" /><controls:NexaAdaptiveLibraryGrid Items="{x:Bind ViewModel.InstalledAppItems, Mode=OneWay}" ItemInvoked="AdaptiveLibrary_ItemInvoked" GotFocus="CardList_GotFocus" /><controls:NexaEmptySection Glyph="&#xECAA;" Title="No installed applications" Message="Scan Windows Apps from the manage menu to build your icon grid." Visibility="{x:Bind ViewModel.InstalledAppsEmptyVisibility, Mode=OneWay}" /><Button Content="Discover all apps" HorizontalAlignment="Left" Click="ShowDiscoverApps_Click" /></StackPanel>
          <StackPanel x:Name="DiscoverAppsPanel" Spacing="14" Visibility="Collapsed"><ItemsControl ItemsSource="{x:Bind DiscoverAppsViewModel.Categories, Mode=OneWay}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><Button Content="{x:Bind}" Tag="{x:Bind}" Click="DiscoverCategory_Click" MinHeight="42" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ProgressBar IsIndeterminate="True" Visibility="{x:Bind DiscoverAppsViewModel.RefreshVisibility, Mode=OneWay}" /><GridView ItemsSource="{x:Bind DiscoverAppsViewModel.Items, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="DiscoverCard_ItemClick" ScrollViewer.HorizontalScrollMode="Disabled"><GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel><GridView.ItemTemplate><DataTemplate x:DataType="vm:DiscoverAppCardViewModel"><controls:NexaDiscoverAppCard Card="{x:Bind}" /></DataTemplate></GridView.ItemTemplate></GridView></StackPanel>
        </StackPanel>

        <StackPanel x:Name="ModernSectionSurface" Spacing="20" Visibility="Collapsed">
        <StackPanel Spacing="4">
          <TextBlock Text="{x:Bind ViewModel.CurrentSectionTitle, Mode=OneWay}" FontSize="42" FontWeight="SemiBold" />
          <TextBlock Text="{x:Bind ViewModel.SectionDescription, Mode=OneWay}" FontSize="16" Foreground="{StaticResource NexaMutedTextBrush}" />
          <StackPanel x:Name="LibraryToolsPanel" Spacing="8" Visibility="Collapsed">
            <AutoSuggestBox x:Name="LibrarySearch" Width="420" HorizontalAlignment="Left" Margin="0,10,0,0" PlaceholderText="Search title, subtitle, or description" TextChanged="LibrarySearch_TextChanged" QueryIcon="Find" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ComboBox Width="190" Header="Library view" SelectedIndex="0" SelectionChanged="LibraryView_SelectionChanged">
                <x:String>All</x:String><x:String>Games</x:String><x:String>Applications</x:String><x:String>Favorites</x:String><x:String>Recently Added</x:String><x:String>Recently Used</x:String><x:String>Native</x:String><x:String>Emulated</x:String><x:String>Hidden</x:String><x:String>Valid targets</x:String><x:String>Missing targets</x:String>
              </ComboBox>
              <ComboBox Width="190" Header="Sort" SelectedIndex="0" SelectionChanged="LibrarySort_SelectionChanged">
                <x:String>Title</x:String><x:String>Recently added</x:String><x:String>Recently launched</x:String><x:String>Most played</x:String>
              </ComboBox>
              <ComboBox Width="190" Header="Presentation" SelectedIndex="0" SelectionChanged="LibraryPresentation_SelectionChanged"><x:String>Adaptive Grid</x:String><x:String>Compact List</x:String><x:String>Game Covers</x:String><x:String>Application Icons</x:String></ComboBox>
            </StackPanel>
          </StackPanel>
          <StackPanel x:Name="GamesToolsPanel" Orientation="Horizontal" Spacing="10" Visibility="Collapsed"><ComboBox Width="190" Header="Games view" SelectedIndex="0" SelectionChanged="GamesPresentation_SelectionChanged"><x:String>Wide Grid</x:String><x:String>Cover Grid</x:String></ComboBox></StackPanel>
        </StackPanel>

        <controls:NexaAdaptiveLibraryGrid x:Name="SectionAdaptiveGrid" Items="{x:Bind ViewModel.CurrentSectionItems, Mode=OneWay}" ItemInvoked="AdaptiveLibrary_ItemInvoked" GotFocus="CardList_GotFocus" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Grid x:Name="CrossbarRoot" Grid.Row="0" Grid.RowSpan="4" Canvas.ZIndex="20" Background="#FF020816" Visibility="Collapsed">
      <Grid.Resources>
        <Style x:Key="CrossbarPrimaryButtonStyle" TargetType="Button">
          <Setter Property="Width" Value="128" /><Setter Property="Height" Value="116" />
          <Setter Property="Padding" Value="8" /><Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="#FF8190AC" />
          <Setter Property="CornerRadius" Value="10" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="CrossbarRailButtonStyle" TargetType="Button">
          <Setter Property="Height" Value="62" /><Setter Property="Padding" Value="18,0" />
          <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
          <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="#FF9AA9C3" />
          <Setter Property="CornerRadius" Value="8" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="CrossbarCardItemStyle" TargetType="ListViewItem">
          <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,12,0" />
          <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
      </Grid.Resources>

      <Image Source="{x:Bind ViewModel.DashboardBackgroundArtwork, Mode=OneWay}" Stretch="UniformToFill" Opacity="0.08" IsHitTestVisible="False" />
      <Grid IsHitTestVisible="False">
        <Grid.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F8020816" Offset="0" /><GradientStop Color="#E9041739" Offset="0.48" /><GradientStop Color="#FB01050E" Offset="1" />
          </LinearGradientBrush>
        </Grid.Background>
        <Path Height="420" Margin="-80,0,-120,44" VerticalAlignment="Bottom" Stretch="Fill" Stroke="#553E91FF" StrokeThickness="20" Data="M 0,250 C 390,80 650,430 980,250 C 1260,95 1480,80 1920,210" />
        <Path Height="360" Margin="-100,0,-180,72" VerticalAlignment="Bottom" Stretch="Fill" Stroke="#3B69C6FF" StrokeThickness="7" Data="M 0,280 C 370,135 620,390 940,275 C 1260,160 1450,90 1920,185" />
        <Path Height="300" Margin="-120,0,-220,92" VerticalAlignment="Bottom" Stretch="Fill" Stroke="#243779F4" StrokeThickness="28" Data="M 0,270 C 410,170 620,360 1030,245 C 1380,145 1580,110 1920,155" />
      </Grid>

      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="224" /><RowDefinition Height="*" /><RowDefinition Height="72" /></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="66,24,66,0">
          <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid>
            <TextBlock Text="NexaStation" FontSize="26" Foreground="#FFAEB8C9" VerticalAlignment="Center" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">

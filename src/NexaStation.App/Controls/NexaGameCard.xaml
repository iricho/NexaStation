<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NexaStation.App.Controls.NexaGameCard" x:Name="ControlRoot" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:NexaStation.App.Controls" DataContext="{x:Bind Card, Mode=OneWay}" IsTabStop="False">
  <Border Width="{Binding Width}" Height="{Binding Height}" Style="{StaticResource NexaCardBorderStyle}" Background="{StaticResource NexaCardGradient}" AutomationProperties.Name="{Binding Title}">
    <Grid>
      <local:NexaArtworkSurface Source="{Binding Artwork}" FallbackBrush="{Binding FallbackBrush}" FallbackText="{Binding FallbackInitial}" />
      <Border Background="{StaticResource NexaCardScrimBrush}" />
      <Border Margin="12" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="6" Background="#B70A0E17"><TextBlock Text="{Binding ProviderLabel}" Style="{StaticResource NexaCaptionStyle}" /></Border>
      <StackPanel VerticalAlignment="Bottom" Padding="16,12" Spacing="3">
        <TextBlock Text="{Binding Title}" Style="{StaticResource NexaCardTitleStyle}" />
        <TextBlock Text="{Binding ActivityLabel}" Style="{StaticResource NexaCardSubtitleStyle}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>

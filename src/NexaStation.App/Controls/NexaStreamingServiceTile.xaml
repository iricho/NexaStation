<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NexaStation.App.Controls.NexaStreamingServiceTile" x:Name="RootControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" DataContext="{x:Bind Card, Mode=OneWay}">
  <Border Width="176" Height="176" Margin="0,0,12,0" Padding="14" CornerRadius="18" Background="{Binding TileBrush}" BorderBrush="{StaticResource NexaAccentBorderBrush}" BorderThickness="1" AutomationProperties.Name="{Binding DisplayName}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid Width="82" Height="82" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding Initial}" Visibility="{Binding InitialVisibility}" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image Source="{Binding Icon}" Visibility="{Binding IconVisibility}" AutomationProperties.Name="{Binding IconAutomationName}" Stretch="Uniform" /></Grid><StackPanel Grid.Row="1"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" /><TextBlock Text="{Binding StateBadge}" FontSize="11" Opacity="0.85" HorizontalAlignment="Center" /><TextBlock Text="{Binding PrimaryAction}" FontSize="11" Foreground="{StaticResource NexaAccentBrush}" HorizontalAlignment="Center" /></StackPanel></Grid>
  </Border>
</UserControl>

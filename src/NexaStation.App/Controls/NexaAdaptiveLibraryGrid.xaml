<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NexaStation.App.Controls.NexaAdaptiveLibraryGrid" x:Name="ControlRoot" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:NexaStation.App.ViewModels" xmlns:local="using:NexaStation.App.Controls">
  <UserControl.Resources><DataTemplate x:Key="GameTemplate" x:DataType="vm:CardViewModel"><local:NexaGameCard Card="{x:Bind}" ActionRequested="GameCard_ActionRequested" /></DataTemplate><DataTemplate x:Key="AppTemplate" x:DataType="vm:CardViewModel"><local:NexaApplicationTile Card="{x:Bind}" /></DataTemplate><local:ContentCardTemplateSelector x:Key="Selector" GameTemplate="{StaticResource GameTemplate}" ApplicationTemplate="{StaticResource AppTemplate}" MediaTemplate="{StaticResource AppTemplate}" /></UserControl.Resources>
  <GridView x:Name="LibraryGrid" Padding="6,6,6,12" ItemsSource="{x:Bind Items, Mode=OneWay}" ItemTemplateSelector="{StaticResource Selector}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Grid_ItemClick" SizeChanged="Grid_SizeChanged" XYFocusKeyboardNavigation="Enabled" TabNavigation="Once" ScrollViewer.IsVerticalScrollChainingEnabled="True" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"><GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel><GridView.ItemContainerStyle><Style TargetType="GridViewItem" BasedOn="{StaticResource CardGridStyle}" /></GridView.ItemContainerStyle></GridView>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NexaStation.App.Controls.NexaHomeActivityRow" x:Name="RootControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:NexaStation.App.Controls" DataContext="{x:Bind Card, Mode=OneWay}" IsTabStop="False">
  <Border Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" CornerRadius="8" Background="{StaticResource NexaElevatedBrush}" BorderBrush="{StaticResource NexaCardBorderBrush}" BorderThickness="1" AutomationProperties.Name="{Binding Title}">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><local:NexaArtworkSurface Source="{Binding Artwork}" FallbackBrush="{Binding FallbackBrush}" FallbackText="{Binding FallbackInitial}" /><StackPanel Grid.Column="1" Margin="10,4" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding ActivityLabel}" FontSize="10" Foreground="{StaticResource NexaMutedTextBrush}" /></StackPanel></Grid>
  </Border>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NexaStation.App.Controls.NexaToastHost" x:Name="ControlRoot" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <InfoBar IsOpen="True" Severity="{x:Bind Severity, Mode=OneWay}" Title="{x:Bind Title, Mode=OneWay}" Message="{x:Bind Message, Mode=OneWay}" IsClosable="True" CloseButtonClick="InfoBar_CloseButtonClick" MaxWidth="620" Background="{StaticResource NexaToastBrush}" AutomationProperties.LiveSetting="Assertive">
    <InfoBar.Content><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="PrimaryButton" Content="{x:Bind PrimaryText, Mode=OneWay}" Click="PrimaryButton_Click" Visibility="Collapsed" /><Button x:Name="SecondaryButton" Content="{x:Bind SecondaryText, Mode=OneWay}" Click="SecondaryButton_Click" Visibility="Collapsed" /></StackPanel></InfoBar.Content>
  </InfoBar>
</UserControl>

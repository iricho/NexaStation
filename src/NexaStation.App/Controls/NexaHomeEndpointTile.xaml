<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NexaStation.App.Controls.NexaHomeEndpointTile" x:Name="RootControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Button HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="8" CornerRadius="12" Background="{StaticResource NexaElevatedBrush}" BorderBrush="{StaticResource NexaCardBorderBrush}" BorderThickness="1" Click="Endpoint_Click" AutomationProperties.Name="{x:Bind Label, Mode=OneWay}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
      <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource NexaAccentTintBrush}" BorderBrush="{StaticResource NexaAccentBorderBrush}" BorderThickness="1">
        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="21" Foreground="{StaticResource NexaAccentBrush}" />
      </Border>
      <TextBlock Text="{x:Bind Label, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="WrapWholeWords" MaxLines="2" />
      <FontIcon Glyph="&#xE72A;" FontSize="10" Foreground="{StaticResource NexaMutedTextBrush}" />
    </StackPanel>
  </Button>
</UserControl>

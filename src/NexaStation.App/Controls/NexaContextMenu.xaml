<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="NexaStation.App.Controls.NexaContextMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NexaStation.App.Controls"
    DefaultButton="None"
    CloseButtonText="Close"
    MinWidth="430"
    MaxWidth="560"
    AutomationProperties.Name="Item actions">
  <Grid MinHeight="180" MaxHeight="650" RowSpacing="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid>
      <Button x:Name="BackButton" Content="&#xE72B;  Back" Click="Back_Click" Visibility="Collapsed" HorizontalAlignment="Left" />
      <TextBlock x:Name="LevelTitle" FontSize="14" Opacity="0.72" HorizontalAlignment="Right" VerticalAlignment="Center" />
    </Grid>
    <ListView x:Name="ActionList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="ActionList_ItemClick">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:NexaContextActionRow">
          <Grid MinHeight="58" Padding="8,5" ColumnSpacing="12" Opacity="{x:Bind Opacity}" AutomationProperties.Name="{x:Bind AccessibilityName}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="{x:Bind Glyph}" FontSize="19" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{x:Bind Label}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{x:Bind SupportingText}" FontSize="12" Opacity="0.68" TextWrapping="Wrap" Visibility="{x:Bind SupportingVisibility}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Image Source="{x:Bind ShortcutAsset}" Width="22" Height="22" Stretch="Uniform" Visibility="{x:Bind ShortcutAssetVisibility}" AutomationProperties.AccessibilityView="Raw" />
              <TextBlock Text="{x:Bind ShortcutHint}" Opacity="0.72" VerticalAlignment="Center" Visibility="{x:Bind ShortcutTextVisibility}" />
              <FontIcon Glyph="&#xE76C;" Visibility="{x:Bind ChildIndicatorVisibility}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</ContentDialog>

<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NexaStation.App.Controls.NexaHeroBanner" x:Name="ControlRoot" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border x:Name="HeroFrame" CornerRadius="{StaticResource NexaRadiusHero}" Background="{StaticResource NexaHeroFallbackBrush}" BorderBrush="{StaticResource NexaHeroBorderBrush}" BorderThickness="1">
    <Grid>
      <Grid Opacity="0.8"><Ellipse Width="430" Height="430" Margin="0,-160,90,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{StaticResource NexaFallbackGlowBrush}" /><Polygon Points="0,180 420,0 620,220 230,360" Fill="#0FFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,180,-120" /></Grid>
      <Image Source="{x:Bind Artwork, Mode=OneWay}" Stretch="UniformToFill" />
      <Border Background="{StaticResource NexaHeroScrimBrush}" />
      <StackPanel MaxWidth="560" Margin="50,26" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="10">
        <Border HorizontalAlignment="Left" Padding="9,4" CornerRadius="4" Background="{StaticResource NexaAccentBrush}"><TextBlock Text="FEATURED" Foreground="{StaticResource NexaInverseAccentTextBrush}" FontSize="10" FontWeight="SemiBold" CharacterSpacing="70" /></Border>
        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource NexaHeroTitleStyle}" />
        <TextBlock Text="{x:Bind Description, Mode=OneWay}" FontSize="15" TextWrapping="Wrap" MaxLines="2" Foreground="{StaticResource NexaSoftWhiteBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0"><Button Style="{StaticResource HeroPrimaryButtonStyle}" Click="PrimaryButton_Click"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE768;" FontSize="16" /><TextBlock Text="{x:Bind PrimaryText, Mode=OneWay}" /></StackPanel></Button><Button Style="{StaticResource HeroSecondaryButtonStyle}" Click="SecondaryButton_Click"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE946;" FontSize="16" /><TextBlock Text="{x:Bind SecondaryText, Mode=OneWay}" /></StackPanel></Button></StackPanel>
      </StackPanel>
      <StackPanel x:Name="HeroIndicators" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,18" />
    </Grid>
  </Border>
</UserControl>

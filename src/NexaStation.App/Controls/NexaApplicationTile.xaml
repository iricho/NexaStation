<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NexaStation.App.Controls.NexaApplicationTile" x:Name="ControlRoot" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:NexaStation.App.Controls" DataContext="{x:Bind Card, Mode=OneWay}" IsTabStop="False">
  <Border Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" Style="{StaticResource NexaCardBorderStyle}" Background="{Binding FallbackBrush}" AutomationProperties.Name="{Binding Presentation.AccessibilityName}">
    <Grid>
      <local:NexaArtworkSurface Margin="34,22,34,58" Source="{Binding Artwork}" FallbackBrush="{Binding FallbackBrush}" FallbackText="{Binding FallbackInitial}" ArtworkStretch="Uniform" />
      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="6,2" CornerRadius="7" Background="{StaticResource NexaArtworkBadgeBrush}"><TextBlock Text="{Binding ProviderLabel}" Foreground="{StaticResource NexaArtworkMutedBrush}" FontSize="11" CharacterSpacing="50" /></Border>
      <Border VerticalAlignment="Bottom" MinHeight="56" Background="#D20A0E17" Padding="12,7">
        <StackPanel Spacing="1"><TextBlock Text="{Binding Title}" Foreground="{StaticResource NexaArtworkTextBrush}" Style="{StaticResource NexaCardTitleStyle}" MaxLines="1" /><TextBlock Text="{Binding ActivityLabel}" Foreground="{StaticResource NexaArtworkMutedBrush}" Style="{StaticResource NexaCardSubtitleStyle}" MaxLines="1" /></StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>

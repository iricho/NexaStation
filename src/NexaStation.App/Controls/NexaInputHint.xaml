<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NexaStation.App.Controls.NexaInputHint" x:Name="RootControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
    <Border x:Name="GlyphSurface" MinWidth="28" Height="28" Padding="5,0" CornerRadius="14" BorderBrush="{StaticResource NexaAccentBrush}" BorderThickness="2" Background="#14000000">
      <Grid>
        <Image x:Name="GlyphImage" Width="20" Height="20" Stretch="Uniform" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
        <TextBlock x:Name="GlyphText" Foreground="{StaticResource NexaAccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <TextBlock x:Name="LabelText" VerticalAlignment="Center" />
  </StackPanel>
</UserControl>

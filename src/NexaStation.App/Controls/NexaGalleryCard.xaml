<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NexaStation.App.Controls.NexaGalleryCard" x:Name="ControlRoot" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:NexaStation.App.Controls" DataContext="{x:Bind Card, Mode=OneWay}" Loaded="ControlRoot_Loaded" Unloaded="ControlRoot_Unloaded" IsTabStop="False">
  <Border Width="{Binding Width}" Height="{Binding Height}" Style="{StaticResource NexaCardBorderStyle}" Background="{StaticResource NexaCardGradient}" AutomationProperties.Name="{Binding AccessibleName}">
    <Grid><local:NexaArtworkSurface Source="{Binding Thumbnail}" FallbackText="{Binding FallbackGlyph}" /><Border Background="{StaticResource NexaCardScrimBrush}" /><StackPanel VerticalAlignment="Bottom" Padding="13,8"><TextBlock Text="{Binding DisplayTitle}" Style="{StaticResource NexaCardTitleStyle}" /><TextBlock Text="{Binding MediaLabel}" Style="{StaticResource NexaCardSubtitleStyle}" /></StackPanel><Border Visibility="{Binding VideoBadgeVisibility}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="7,3" CornerRadius="5" Background="#C70A0E17"><TextBlock Text="VIDEO" Style="{StaticResource NexaCaptionStyle}" /></Border></Grid>
  </Border>
</UserControl>

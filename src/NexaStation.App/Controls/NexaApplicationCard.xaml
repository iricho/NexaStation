<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NexaStation.App.Controls.NexaApplicationCard" x:Name="ControlRoot" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:NexaStation.App.Controls" DataContext="{x:Bind Card, Mode=OneWay}" IsTabStop="False">
  <Border Width="{Binding Width}" Height="{Binding Height}" Style="{StaticResource NexaCardBorderStyle}" Background="{Binding FallbackBrush}" AutomationProperties.Name="{Binding Title}">
    <Grid>
      <local:NexaArtworkSurface Margin="32,22,32,54" Source="{Binding Artwork}" FallbackBrush="{Binding FallbackBrush}" FallbackText="{Binding FallbackInitial}" ArtworkStretch="Uniform" />
      <Border VerticalAlignment="Bottom" Height="58" Background="#C80A0E17" />
      <StackPanel VerticalAlignment="Bottom" Padding="14,8" Spacing="1"><TextBlock Text="{Binding Title}" Style="{StaticResource NexaCardTitleStyle}" /><TextBlock Text="{Binding ActivityLabel}" Style="{StaticResource NexaCardSubtitleStyle}" /></StackPanel>
    </Grid>
  </Border>
</UserControl>

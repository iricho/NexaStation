<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NexaStation.App.Controls.NexaHomeGalleryTile" x:Name="RootControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:NexaStation.App.Controls" DataContext="{x:Bind Card, Mode=OneWay}" Loaded="ControlRoot_Loaded" Unloaded="ControlRoot_Unloaded" IsTabStop="False">
  <Border Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" CornerRadius="11" BorderBrush="{StaticResource NexaCardBorderBrush}" BorderThickness="1" Background="{StaticResource NexaCardGradient}" AutomationProperties.Name="{Binding AccessibleName}">
    <Grid><local:NexaArtworkSurface Source="{Binding Thumbnail}" FallbackText="{Binding FallbackGlyph}" /><Border Background="#18000000" /><Border Visibility="{Binding VideoBadgeVisibility}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7" Padding="5,2" CornerRadius="4" Background="#C70A0E17"><TextBlock Text="VIDEO" FontSize="9" /></Border></Grid>
  </Border>
</UserControl>

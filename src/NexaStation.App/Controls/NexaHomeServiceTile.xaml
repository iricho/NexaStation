<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NexaStation.App.Controls.NexaHomeServiceTile" x:Name="RootControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" DataContext="{x:Bind Card, Mode=OneWay}" IsTabStop="False">
  <Border Width="{Binding DisplaySize}" Height="86" CornerRadius="11" Background="{Binding TileBrush}" BorderBrush="{StaticResource NexaCardBorderBrush}" BorderThickness="1" AutomationProperties.Name="{Binding DisplayName}">
    <Grid><Grid Width="58" Height="51" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,7,0,0"><TextBlock Text="{Binding Initial}" Foreground="{StaticResource NexaArtworkTextBrush}" Visibility="{Binding InitialVisibility}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image Source="{Binding Icon}" Visibility="{Binding IconVisibility}" AutomationProperties.Name="{Binding IconAutomationName}" Stretch="Uniform" /></Grid><Border VerticalAlignment="Bottom" Height="29" Background="#9D0A0E17" Padding="5,4"><TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource NexaArtworkTextBrush}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" /></Border></Grid>
  </Border>
</UserControl>

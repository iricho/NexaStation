<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NexaStation.App.Controls.NexaCollectionCard" x:Name="RootControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" DataContext="{x:Bind Card, Mode=OneWay}">
  <Border Width="286" Height="220" CornerRadius="18" Background="{StaticResource NexaSurfaceBrush}" BorderBrush="{StaticResource NexaAccentBorderBrush}" BorderThickness="1" AutomationProperties.Name="{Binding AccessibilityName}"><Grid><Image Source="{Binding Mosaic}" Stretch="UniformToFill" Visibility="{Binding MosaicVisibility}" /><Grid Visibility="{Binding FallbackVisibility}" Background="{StaticResource NexaCardGradient}"><FontIcon Glyph="&#xE8B7;" FontSize="54" Foreground="{StaticResource NexaAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid><Border VerticalAlignment="Bottom" Background="#D60A0E17" Padding="14,10"><Grid><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="18" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Description}" Foreground="{StaticResource NexaMutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel><TextBlock Text="{Binding ItemCountLabel}" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="11" /></Grid></Border></Grid></Border>
</UserControl>

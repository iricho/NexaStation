<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NexaStation.App.Controls.NexaEmptyState" x:Name="ControlRoot" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Border Padding="32" CornerRadius="16" Background="{StaticResource NexaPanelBrush}" BorderBrush="{StaticResource NexaCardBorderBrush}" BorderThickness="1"><StackPanel HorizontalAlignment="Center" Spacing="10"><FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="34" Foreground="{StaticResource NexaAccentBrush}" /><TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="{x:Bind Message, Mode=OneWay}" MaxWidth="480" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource NexaMutedTextBrush}" /></StackPanel></Border></UserControl>

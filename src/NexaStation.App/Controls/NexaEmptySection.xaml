<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NexaStation.App.Controls.NexaEmptySection" x:Name="RootControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Padding="22" CornerRadius="16" Background="{StaticResource NexaSurfaceBrush}"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="28" Foreground="{StaticResource NexaAccentBrush}" /><StackPanel><TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{x:Bind Message, Mode=OneWay}" Foreground="{StaticResource NexaMutedTextBrush}" TextWrapping="Wrap" /></StackPanel></StackPanel></Border>
</UserControl>

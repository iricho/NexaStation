<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NexaStation.App.Controls.NexaEmptySection" x:Name="RootControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Padding="24" CornerRadius="16" Background="{StaticResource NexaSurfaceBrush}">
    <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="28" Foreground="{StaticResource NexaAccentBrush}" VerticalAlignment="Top" Margin="0,4,0,0" />
      <StackPanel Grid.Column="1" Spacing="6">
        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{x:Bind Message, Mode=OneWay}" Foreground="{StaticResource NexaMutedTextBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>

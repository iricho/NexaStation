<UserControl x:Class="NexaStation.App.Controls.NexaCrossbarPosterCard" x:Name="RootControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:NexaStation.App.Controls" DataContext="{x:Bind Card, Mode=OneWay}" IsTabStop="False">
  <Grid Width="{Binding CrossbarWidth}" Height="{Binding CrossbarHeight}" AutomationProperties.Name="{Binding Title}">
    <Grid Visibility="{Binding CrossbarSelectionVisibility}" IsHitTestVisible="False">
      <Border Margin="-7" CornerRadius="16" BorderThickness="7" BorderBrush="{StaticResource CrossbarGlowOuterBrush}" />
      <Border Margin="-4" CornerRadius="13" BorderThickness="5" BorderBrush="{StaticResource CrossbarGlowMiddleBrush}" />
      <Border Margin="-2" CornerRadius="11" BorderThickness="3" BorderBrush="{StaticResource CrossbarAccentBrush}" />
    </Grid>
    <Border CornerRadius="8" BorderBrush="{StaticResource CrossbarBorderBrush}" BorderThickness="1" Background="{StaticResource CrossbarSurfaceBrush}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="66"/></Grid.RowDefinitions>
        <Border CornerRadius="7,7,0,0" Background="{Binding FallbackBrush}" Padding="{Binding CrossbarArtworkPadding}">
          <local:NexaArtworkSurface Source="{Binding Artwork}" ArtworkStretch="{Binding CrossbarArtworkStretch}" FallbackBrush="{Binding FallbackBrush}" FallbackText="{Binding FallbackInitial}" />
        </Border>
        <Grid Grid.Row="1" Padding="9,7,7,7" RowSpacing="6">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="{Binding Title}" Foreground="{StaticResource CrossbarTextBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource CrossbarElevatedBrush}" CornerRadius="4" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding CrossbarPlatformLabel}" Foreground="{StaticResource CrossbarMutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/></Border>
            <Button Grid.Column="1" Padding="0" MinWidth="24" MinHeight="24" Background="Transparent" BorderThickness="0" Foreground="{StaticResource CrossbarMutedBrush}" Content="•••" IsTabStop="False" Click="Options_Click" AutomationProperties.Name="Item options"/>
          </Grid>
        </Grid>
      </Grid>
    </Border>
    <Border Visibility="{Binding CrossbarSelectionVisibility}" CornerRadius="8" BorderThickness="2" BorderBrush="{StaticResource CrossbarSelectionBrush}" IsHitTestVisible="False"/>
  </Grid>
</UserControl>
